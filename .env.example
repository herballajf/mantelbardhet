# ==============================================================================
# UNIVERSITETI I PRISHTINËS - FAKULTETI I MJEKËSISË
# Konfigurimi i Mjedisit (Environment Configuration)
# ==============================================================================

# Porti i Serverit
PORT=3000

# Baza e të Dhënave
# SQLite është vetëm për zhvillim lokal. Në Render/production, përdorni një bazë të jashtme
# për të mos humbur të dhënat pas redeploy, restart ose migrimi i GitHub.
# DATABASE_URL=postgres://user:password@host:5432/database_name
DATABASE_PATH=data.sqlite

# Sekreti i Sigurisë JWT
JWT_SECRET=up_medicina_secret_jwt_key_production_2026

# Konfigurimi i Serverit të Emailit (SMTP)
# Mund të konfigurohet gjithashtu direkt nga Paneli i Administratorit (Settings)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=biletat@uni-pr.edu
SMTP_PASS=app_specific_password_here
SMTP_FROM=biletat@uni-pr.edu

# Resend Email API (alternativë kur hosti bllokon SMTP; kërkon domen të verifikuar)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your_api_key

# Local SMTP relay: these are used on your laptop, not in Render.
# Keep SMTP credentials only in the laptop's .env file.
# EMAIL_RELAY_SECRET=replace_with_a_long_random_secret
# RELAY_PORT=3100

# In Render, set EMAIL_PROVIDER=local_relay, EMAIL_RELAY_URL to your HTTPS tunnel URL,
# and EMAIL_RELAY_SECRET to the same secret used by the local relay.

# Politika e Ruajtjes së të Dhënave (Ditë)
DATA_RETENTION_DAYS=365
